# BrandProof Desk - Example configuration
# Copy this file to .env and customize locally.

# Local AI - Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=180

# Database
BRANDPROOF_DB_PATH=./brandproof.db

# Agentverse - optional
AGENT_SEED_PHRASE=
AGENT_EXTERNAL_ENDPOINT=
